#include <winver.h>

// Shown in Task Manager and the file's properties.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2, 0, 0, 0
PRODUCTVERSION 2, 0, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "7TV Emote Picker"
            VALUE "ProductName", "7TV Emote Picker"
            VALUE "FileVersion", "2.0"
            VALUE "ProductVersion", "2.0"
            VALUE "OriginalFilename", "7TV Emote Picker.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
